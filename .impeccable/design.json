      "css": ".ds-navigation{display:flex;flex-direction:column;gap:5px;width:220px;padding:18px;background:#17323f;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif}.ds-navigation a{display:flex;align-items:center;gap:12px;padding:12px 14px;min-height:44px;border-radius:5px;font-size:13px;color:#c6d8df;text-decoration:none;transition:background .16s,color .16s}.ds-navigation a:hover{background:#254551;color:#fff}.ds-navigation a[aria-current=page]{background:#2b505b;color:#fff;font-weight:600}.ds-navigation a[aria-current=page] svg{color:#b9e7d8}.ds-navigation a:focus-visible{outline:3px solid #238b7e;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-navigation a{transition:none}}"
