# Copy to backend/.env to override. Every value is optional for local development.
# Real environment variables take priority over this file.

# Defaults to backend/ayudachain.db.
# DATABASE_URL=sqlite:///C:/path/to/ayudachain.db

# Local Hardhat chain by default.
# POLYGON_RPC_URL=http://127.0.0.1:8545

# Defaults to Hardhat test account #0 (public, local chain only). Never commit a real key.
# POLYGON_PRIVATE_KEY=

# Defaults to the address and chain ID in app/blockchain/AyudaChainRegistry.json,
# which the deploy script writes.
# CONTRACT_ADDRESS=
# CHAIN_ID=31337

# Comma-separated list of allowed frontend origins. Defaults to all origins.
# CORS_ORIGINS=http://localhost:3000
