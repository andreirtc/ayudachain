# AyudaChain Multi-Layer .gitignore
# Covers Node.js, Next.js, Python, Hardhat, SQLite, and System Files

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Preserve example environment template
!.env.example

# ==========================================
# Node.js & Package Managers
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Next.js Build Outputs
# ==========================================
.next/
out/
build/
dist/
tsconfig.tsbuildinfo
next-env.d.ts.bak

# ==========================================
# Python & Virtual Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Databases & Runtime State
# ==========================================
*.db
*.db-journal
*.sqlite
*.sqlite3
ayudachain.db
backend/ayudachain.db

# Keep sample receipt template in repo, ignore runtime batch artifacts
backend/app/data/receipts/DIST-*.svg
frontend/public/receipts/

# ==========================================
# Hardhat & Smart Contracts
# ==========================================
contracts/artifacts/
contracts/cache/
contracts/typechain/
contracts/typechain-types/
artifacts/
cache/

# ==========================================
# Operating System & IDE Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ==========================================
# Temporary Logs
# ==========================================
*.log
/tmp/ayudachain*
